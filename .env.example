# Kernector local environment template.
# Copy to `.env` and fill in values. Never commit real secrets.
#
# Next.js public vars live in `web/.env.example` (copy to `web/.env.local`).
# Process environment wins over this file (`load_dotenv(override=False)`).

# --- HTTP adapter / CORS (Next.js local shell) ---
# Enable only for local dual-stack development. Leave unset/false in production.
HTTP_DEV_CORS=true
# Comma-separated allowlist. Never use `*`.
HTTP_CORS_ORIGINS=http://localhost:3000

# --- Logging ---
LOG_LEVEL=INFO

# --- LLM provider (optional for UI/API that call models; not required by CI) ---
# LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# OPENROUTER_EMBEDDING_MODEL=
# OLLAMA_BASE_URL=
# OLLAMA_MODEL=

# --- Hybrid search (optional) ---
# HYBRID_SEARCH_ENABLED=false
# HYBRID_ALPHA=0.5
# RELEVANCE_THRESHOLD=0.0

# --- Document catalog (SQL only) ---
# DOCUMENT_CATALOG_SQL_PATH defaults to data/catalog/catalog.sqlite
# DOCUMENT_CATALOG_SQL_PATH=data/catalog/catalog.sqlite
# Required to open the catalog: case-sensitive fullmatch [A-Za-z0-9_-]+, at most 64 characters.
DOCUMENT_CATALOG_WORKSPACE_ID=local
# Original upload bytes (flat files keyed by source_id); created on first put.
# DOCUMENT_UPLOAD_BLOB_PATH=data/uploads

# --- Google Drive CLI sync (optional; #196 service account) ---
# Install with: uv sync --extra google-drive
# Keep the service-account JSON key outside the repository.
# Share the target Drive folder with the service-account email.
# GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=
# Folder ID charset: letters, digits, `-`, `_`, at most 128 characters
# (validated when the connector is built / status reports configured).
# GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_DRIVE_PAGE_SIZE=100

# --- Google Drive user OAuth (Knowledge Hub / Next.js) ---
# Create a Google Cloud OAuth client (Web application).
# Authorized redirect URI must match exactly:
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/connectors/google-drive/oauth/callback
# GOOGLE_OAUTH_FRONTEND_REDIRECT=http://localhost:3000/documents
# GOOGLE_OAUTH_TOKEN_PATH=data/google-oauth-connection.json
# GOOGLE_OAUTH_STATE_PATH=data/google-oauth-state.json
# Filenames must stay google-oauth-*.json so git ignores the grant.
# GOOGLE_OAUTH_STATE_TTL_SECONDS=600
# Scope defaults to drive.readonly (restricted): required for recursive folder sync.
# When DOMAIN_TOOL_PACKS includes software-delivery, Connect also requests drive.file
# (incremental) so Test Design can export Markdown into a user-chosen folder.
# Add drive.file on the Google Cloud OAuth consent screen before enabling export.
# Google verification / security assessment may apply before production use.
#
# --- Google Drive export (Hub OAuth; #197) ---
# Destination folder is chosen in the Test Design export dialog (not env).
# Artifact size is capped by packs/software_delivery/limits.py.

# --- GitHub connector (CLI PAT + Hub OAuth) ---
# Install: uv sync --extra github
# Hub: Connect, then pick repository/project in the UI (selection is stored on the grant).
# Optional env below pre-seeds Hub selection after Connect and is required for CLI PAT sync.
# GITHUB_TOKEN=
# GITHUB_OWNER=
# GITHUB_REPO=
# GITHUB_REF=HEAD
# GITHUB_INCLUDE_PATHS=
# GITHUB_EXCLUDE_PATHS=
# GITHUB_EXTENSIONS=.md,.markdown,.txt,.py,.ts,.tsx,.js,.json,.yaml,.yml
# GITHUB_MAX_FILE_BYTES=1048576
# GITHUB_PROJECT_OWNER=
# GITHUB_PROJECT_NUMBER=
# GITHUB_PAGE_SIZE=100
# Stable opaque id for CLI PAT sync / reconcile (Hub OAuth mints and stores one).
# GITHUB_CONNECTOR_ID=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/connectors/github/oauth/callback
# GITHUB_OAUTH_FRONTEND_REDIRECT=http://localhost:3000/documents
# GITHUB_OAUTH_TOKEN_PATH=data/github-oauth-connection.json
# GITHUB_OAUTH_STATE_PATH=data/github-oauth-state.json
# Filenames must stay github-oauth-*.json so git ignores the grant.
# GITHUB_OAUTH_STATE_TTL_SECONDS=600

# --- RAG LLM-as-Judge (optional; #106). Never defaulted from LLM_PROVIDER. ---
# Required for --judge-mode live. Independent of the answer model.
# RAG_JUDGE_PROVIDER=openrouter
# RAG_JUDGE_MODEL=
# RAG_JUDGE_BASE_URL=
# RAG_JUDGE_SEED=

# --- MCP Streamable HTTP (presentation/mcp, #320) ---
# Required when running: uv run uvicorn presentation.mcp.app:app --port 8100
# MCP_AUTH_TOKEN=  # shared bearer (trusted MVP, not OAuth); required for /mcp
# MCP_ALLOWED_HOSTS=127.0.0.1:8100  # required; no wildcards
# MCP_ALLOWED_ORIGINS=  # optional exact origins; missing Origin allowed for non-browser clients
# MCP_ACCESS_PROFILE=default
# MCP_TOOL_ALLOWLIST=core.search_knowledge
# Live Software Delivery MCP tools are contributed later (#326/#327); do not
# revive retired scaffolding risk/generate/markdown export tools (#285).
