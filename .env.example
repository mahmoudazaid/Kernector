# Kernector local environment template.
# Copy to `.env` and fill in values. Never commit real secrets.
#
# Next.js public vars live in `web/.env.example` (copy to `web/.env.local`).

# --- HTTP adapter / CORS (Next.js local shell) ---
# Enable only for local dual-stack development. Leave unset/false in production.
HTTP_DEV_CORS=true
# Comma-separated allowlist. Never use `*`.
HTTP_CORS_ORIGINS=http://localhost:3000

# --- Logging ---
LOG_LEVEL=INFO

# --- LLM provider (optional for UI/API that call models; not required by CI) ---
# LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# OPENROUTER_EMBEDDING_MODEL=
# OLLAMA_BASE_URL=
# OLLAMA_MODEL=

# --- Hybrid search (optional) ---
# HYBRID_SEARCH_ENABLED=false
# HYBRID_ALPHA=0.5
# RELEVANCE_THRESHOLD=0.0

# --- Document catalog ---
# json (default): unscoped local/single-process adapter.
# sql: transactional SQLite adapter; requires DOCUMENT_CATALOG_WORKSPACE_ID.
# DOCUMENT_CATALOG_BACKEND=json
# DOCUMENT_CATALOG_PATH=data/catalog/uploads.json
# DOCUMENT_CATALOG_SQL_PATH=data/catalog/catalog.sqlite
# DOCUMENT_CATALOG_WORKSPACE_ID=

# --- Google Drive connector (optional; #196) ---
# Install with: uv sync --extra google-drive
# Keep the service-account JSON key outside the repository.
# Share the target Drive folder with the service-account email.
# GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=
# GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_DRIVE_PAGE_SIZE=100
