# Kernector local environment template.
# Copy to `.env` and fill in values. Never commit real secrets.
#
# Next.js public vars live in `web/.env.example` (copy to `web/.env.local`).
# Process environment wins over this file (`load_dotenv(override=False)`).

# --- HTTP adapter / CORS (Next.js local shell) ---
# Enable only for local dual-stack development. Leave unset/false in production.
HTTP_DEV_CORS=true
# Comma-separated allowlist. Never use `*`.
HTTP_CORS_ORIGINS=http://localhost:3000

# --- Logging ---
LOG_LEVEL=INFO

# --- LLM provider (optional for UI/API that call models; not required by CI) ---
# Transitional env bootstrap (#462). Workspace SQL profiles (#463/#464) take
# precedence later; #466 completes migration/docs. Prefer one provider at a time.
# LLM_PROVIDER=openrouter|openai|anthropic|gemini|ollama
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# OPENROUTER_EMBEDDING_MODEL=
# OLLAMA_BASE_URL=
# OLLAMA_MODEL=
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2

# --- Hybrid search (optional) ---
# HYBRID_SEARCH_ENABLED=false
# HYBRID_ALPHA=0.5
# RELEVANCE_THRESHOLD=0.0

# --- Document catalog (SQL only) ---
# DOCUMENT_CATALOG_SQL_PATH defaults to data/catalog/catalog.sqlite
# DOCUMENT_CATALOG_SQL_PATH=data/catalog/catalog.sqlite
# Required to open the catalog: case-sensitive fullmatch [A-Za-z0-9_-]+, at most 64 characters.
DOCUMENT_CATALOG_WORKSPACE_ID=local
# Original upload bytes (flat files keyed by source_id); created on first put.
# DOCUMENT_UPLOAD_BLOB_PATH=data/uploads

# --- Google Drive CLI sync (optional; #196 service account) ---
# Install with: uv sync --extra google-drive
# Keep the service-account JSON key outside the repository.
# Share the target Drive folder with the service-account email.
# GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=
# Folder ID charset: letters, digits, `-`, `_`, at most 128 characters
# (validated when the connector is built / status reports configured).
# GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_DRIVE_PAGE_SIZE=100

# --- Google Drive user OAuth (Knowledge Hub / Next.js) ---
# Create a Google Cloud OAuth client (Web application).
# Authorized redirect URI must match exactly:
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/connectors/google-drive/oauth/callback
# GOOGLE_OAUTH_FRONTEND_REDIRECT=http://localhost:3000/documents
# GOOGLE_OAUTH_TOKEN_PATH=data/google-oauth-connection.json
# GOOGLE_OAUTH_STATE_PATH=data/google-oauth-state.json
# Filenames must stay google-oauth-*.json so git ignores the grant.
# GOOGLE_OAUTH_STATE_TTL_SECONDS=600
# Scope defaults to drive.readonly (restricted): required for recursive folder sync.
# When DOMAIN_TOOL_PACKS includes software-delivery, Connect also requests drive.file
# (incremental) so Test Design can export Markdown into a user-chosen folder.
# Add drive.file on the Google Cloud OAuth consent screen before enabling export.
# Google verification / security assessment may apply before production use.
#
# --- Google Drive export (Hub OAuth; #197) ---
# Destination folder is chosen in the Test Design export dialog (not env).
# Artifact size is capped by packs/software_delivery/limits.py.

# --- GitHub connector (CLI PAT + Hub OAuth) ---
# Install: uv sync --extra github
# Hub: Connect, then pick repository/project in the UI (selection is stored on the grant).
# Optional env below pre-seeds Hub selection after Connect and is required for CLI PAT sync.
# GITHUB_TOKEN=
# GITHUB_OWNER=
# GITHUB_REPO=
# GITHUB_REF=HEAD
# GITHUB_INCLUDE_PATHS=
# GITHUB_EXCLUDE_PATHS=
# GITHUB_EXTENSIONS=.md,.markdown,.txt,.py,.ts,.tsx,.js,.json,.yaml,.yml
# GITHUB_MAX_FILE_BYTES=1048576
# GITHUB_PROJECT_OWNER=
# GITHUB_PROJECT_NUMBER=
# GITHUB_PAGE_SIZE=100
# Stable opaque id for CLI PAT sync / reconcile (Hub OAuth mints and stores one).
# GITHUB_CONNECTOR_ID=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/connectors/github/oauth/callback
# GITHUB_OAUTH_FRONTEND_REDIRECT=http://localhost:3000/documents
# GITHUB_OAUTH_TOKEN_PATH=data/github-oauth-connection.json
# GITHUB_OAUTH_STATE_PATH=data/github-oauth-state.json
# Filenames must stay github-oauth-*.json so git ignores the grant.
# GITHUB_OAUTH_STATE_TTL_SECONDS=600

# --- Jira connector (Hub OAuth 2.0 3LO; #296) ---
# Install: uv sync --extra jira
# Atlassian app scopes: read:jira-work read:me (offline_access is requested for refresh).
# One eligible site auto-selects; several require a choice in the Hub picker.
# JIRA_OAUTH_CLIENT_ID=
# JIRA_OAUTH_CLIENT_SECRET=
# JIRA_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/connectors/jira/oauth/callback
# JIRA_OAUTH_FRONTEND_REDIRECT=http://localhost:3000/documents
# JIRA_OAUTH_TOKEN_PATH=data/jira-oauth-connection.json
# JIRA_OAUTH_STATE_PATH=data/jira-oauth-state.json
# Filenames must stay jira-oauth-*.json so git ignores the grant.
# JIRA_OAUTH_STATE_TTL_SECONDS=600
# Issues per search page (1-100).
# JIRA_PAGE_SIZE=100
# Sync aborts without writes above this many issues (1-50000).
# JIRA_MAX_ISSUES=5000
# Include issue comments in synced documents.
# JIRA_INCLUDE_COMMENTS=false

# --- Jira Data Center / Server (self-hosted, 8.14+; #346) ---
# Mutually exclusive with JIRA_OAUTH_CLIENT_ID / JIRA_OAUTH_CLIENT_SECRET.
# Setting either variable below switches Jira to Data Center mode; the
# shared JIRA_PAGE_SIZE / JIRA_MAX_ISSUES / JIRA_INCLUDE_COMMENTS do not.
# Disconnect Jira Cloud in the Hub before switching an existing workspace.
# The API host must reach this URL directly (for example over VPN).
# JIRA_DC_BASE_URL=https://jira.example.com
# Personal Access Token with browse (read) access to the projects to sync.
# Server-side only: never persisted, logged, or sent to the browser.
# JIRA_DC_TOKEN=
# Allow http:// base URLs (lab setups only).
# JIRA_DC_ALLOW_HTTP=false
# Filenames must stay jira-dc-*.json so git ignores the state file.
# JIRA_DC_STATE_PATH=data/jira-dc-connection.json
# Optional Test Design acceptance-criteria text field (customfield_<digits>).
# JIRA_DC_ACCEPTANCE_CRITERIA_FIELD=customfield_10200

# --- Xray test creation (optional; #199) ---
# Creates Jira Test issues from Test Design drafts after human approval.
# Requires the software-delivery pack and DOCUMENT_CATALOG_WORKSPACE_ID.
# cloud = Xray Cloud GraphQL; server = Xray Server/DC via JIRA_DC_BASE_URL/JIRA_DC_TOKEN.
# XRAY_DEPLOYMENT=cloud
# Target Jira project key ([A-Z][A-Z0-9_]*).
# XRAY_PROJECT_KEY=QA
# Issue link type from each test to the draft's Jira issue; blank disables linking.
# XRAY_LINK_TYPE=Test
# Cloud only: Xray API key pair (server-side only; never logged or returned).
# XRAY_CLIENT_ID=
# XRAY_CLIENT_SECRET=
# Cloud only: https base URL without credentials, query, or fragment.
# XRAY_CLOUD_BASE_URL=https://xray.cloud.getxray.app
# Tag names read from Robot Framework / Gherkin test files (#396); used even when
# XRAY_DEPLOYMENT is unset. Single tokens without whitespace or @ : = | , and
# compared case-insensitively. Composite tags look like `XRay ABC-1` (Robot) or
# `@XRay:ABC-1` / `@Story=ABC-1` (Gherkin). XRAY_TEST_TAG is also the marker the
# key write-back tool (#399) writes: `XRay ABC-1` (Robot), `@XRay:ABC-1` (Gherkin).
# XRAY_TEST_TAG=XRay
# XRAY_STORY_TAG=Story
# Comma-separated tags that mark a scenario as a Manual test (otherwise Cucumber).
# XRAY_MANUAL_TAGS=manual,scaffold
# Creating tests from test files (#397). Optional Jira component set on every
# created test; it replaces only the `components` field. Blank means none.
# Updating tests from files (#398) only adds it when missing (Server/DC only).
# XRAY_DEFAULT_COMPONENT=
# Comma-separated Jira issue type names or ids accepted as a test's parent story
# (case-insensitive, no empty or repeated entries).
# XRAY_STORY_ISSUE_TYPES=Story
# Direction of the configured link type from the test toward its parent story
# (outward = test -> story, matching create-from-files). Used by pull (#400).
# XRAY_LINK_DIRECTION=outward
# Basename template for new suites/features when pulling tests with no local
# target file (#400). Placeholders: {epic_key}, {epic_summary}, {story_key},
# {story_summary}. Empty epic placeholders collapse when epic is absent.
# XRAY_NEW_FILE_NAME_TEMPLATE={epic_summary}__{story_summary}

# --- RAG LLM-as-Judge (optional; #106). Never defaulted from LLM_PROVIDER. ---
# Required for --judge-mode live. Independent of the answer model.
# RAG_JUDGE_PROVIDER=openrouter
# RAG_JUDGE_MODEL=
# RAG_JUDGE_BASE_URL=
# RAG_JUDGE_SEED=

# --- MCP Streamable HTTP (presentation/mcp, #320 / #324) ---
# Run: uv run uvicorn presentation.mcp.app:app --host 127.0.0.1 --port 8100
#
# Auth is per-profile bearer tokens (Admin UI /settings/mcp or
# POST /api/v1/admin/mcp/profiles). Hashed tokens + tool allowlists are stored
# in the catalog DB — do NOT set MCP_AUTH_TOKEN, MCP_TOOL_ALLOWLIST, or
# MCP_ACCESS_PROFILE (removed; they no longer authenticate or authorize).
#
# Transport security (deploy/env only — not Admin UI):
# Required Host allowlist; no wildcards
# MCP_ALLOWED_HOSTS=127.0.0.1:8100,localhost:8100
# Optional exact Origin allowlist. Leave empty for local Cursor: empty uses
# Cursor-safe defaults (literal Origin "null", vscode-webview://cursor, and
# localhost HTTP). A non-empty list is exact-match only (no wildcards in env).
# Keep the note on its own line — empty value + inline # is not empty.
# MCP_ALLOWED_ORIGINS=
#
# Interim Admin gate for FastAPI and the Next.js BFF under
# /api/v1/admin/mcp/* (fail closed when unset). Never put in NEXT_PUBLIC_* or
# browser storage. Multi-user Admin RBAC remains #36; end-user auth is #182
# (ADR 0013). Membership + project grants: #446; HTTP/MCP policy wiring: #447.
# ADMIN_API_TOKEN=admin-dev-token
#
# --- Local user auth (#182 / ADR 0013) ---
# AUTH_SQL_PATH=data/auth/auth.sqlite
# AUTH_SESSION_TTL_SECONDS=604800
# AUTH_CSRF_KEY=dev-only-change-me-auth-csrf-key!!
# AUTH_TRUSTED_ORIGINS=http://localhost:3000
# AUTH_LOGIN_MAX_FAILURES=5
# AUTH_LOGIN_LOCKOUT_SECONDS=900
# Session cookie name is fixed to kernector_session (not configurable).
# Provision users: uv run python -m presentation.cli.create_user --username alice
# (password is prompted; there is no --password flag).
# Grant workspace membership + explicit projects (#446):
#   uv run python -m presentation.cli.grant_workspace_access \
#     --username alice --project-id prj_one
#   # or: --all-existing-projects  (never implied by omitting --project-id)
#
# Pack tools (Test Design #338, project_profile #387, Xray, …) appear on MCP
# only when DOMAIN_TOOL_PACKS enables the pack AND the profile allowlists the
# tool ids in Admin UI. Further Software Delivery MCP tools: #326/#327.

