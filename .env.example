# Kernector local environment template.
# Copy to `.env` and fill in values. Never commit real secrets.
#
# Next.js public vars live in `web/.env.example` (copy to `web/.env.local`).

# --- HTTP adapter / CORS (Next.js local shell) ---
# Enable only for local dual-stack development. Leave unset/false in production.
HTTP_DEV_CORS=true
# Comma-separated allowlist. Never use `*`.
HTTP_CORS_ORIGINS=http://localhost:3000

# --- Logging ---
LOG_LEVEL=INFO

# --- LLM provider (optional for UI/API that call models; not required by CI) ---
# LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# OPENROUTER_EMBEDDING_MODEL=
# OLLAMA_BASE_URL=
# OLLAMA_MODEL=

# --- Hybrid search (optional) ---
# HYBRID_SEARCH_ENABLED=false
# HYBRID_ALPHA=0.5
# RELEVANCE_THRESHOLD=0.0

# --- Document catalog (SQL only) ---
# DOCUMENT_CATALOG_SQL_PATH defaults to data/catalog/catalog.sqlite
# DOCUMENT_CATALOG_SQL_PATH=data/catalog/catalog.sqlite
# Required to open the catalog: case-sensitive fullmatch [A-Za-z0-9_-]+, at most 64 characters.
DOCUMENT_CATALOG_WORKSPACE_ID=local

# --- Google Drive CLI sync (optional; #196 service account) ---
# Install with: uv sync --extra google-drive
# Keep the service-account JSON key outside the repository.
# Share the target Drive folder with the service-account email.
# GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=
# GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_DRIVE_PAGE_SIZE=100

# --- Google Drive user OAuth (Knowledge Hub / Next.js) ---
# Create a Google Cloud OAuth client (Web application).
# Authorized redirect URI must match exactly:
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/connectors/google-drive/oauth/callback
# GOOGLE_OAUTH_FRONTEND_REDIRECT=http://localhost:3000/documents
# GOOGLE_OAUTH_TOKEN_PATH=data/google-oauth-connection.json
# GOOGLE_OAUTH_STATE_PATH=data/google-oauth-state.json
# Filenames must stay google-oauth-*.json so git ignores the grant.
# GOOGLE_OAUTH_STATE_TTL_SECONDS=600
# Scope is drive.readonly (restricted): required for recursive folder sync.
# Google verification / security assessment may apply before production use.
