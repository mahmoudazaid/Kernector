{
  "components": {
    "schemas": {
      "CapabilitiesResponse": {
        "description": "Minimal read-only prove-out for the composition boundary.",
        "properties": {
          "default_provider": {
            "title": "Default Provider",
            "type": "string"
          },
          "providers": {
            "items": {
              "type": "string"
            },
            "title": "Providers",
            "type": "array"
          },
          "software_delivery_tools_enabled": {
            "title": "Software Delivery Tools Enabled",
            "type": "boolean"
          }
        },
        "required": [
          "providers",
          "default_provider",
          "software_delivery_tools_enabled"
        ],
        "title": "CapabilitiesResponse",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Operational readiness payload for unversioned ``GET /health``.",
        "properties": {
          "status": {
            "examples": ["ok"],
            "title": "Status",
            "type": "string"
          }
        },
        "required": ["status"],
        "title": "HealthResponse",
        "type": "object"
      },
      "Problem": {
        "description": "RFC 9457 Problem Details plus Kernector extensions.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ProblemError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Errors"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Instance"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Request Id"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": ["type", "title", "status", "detail", "code"],
        "title": "Problem",
        "type": "object"
      },
      "ProblemError": {
        "description": "Field-level Problem Details extension entry.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "pointer": {
            "title": "Pointer",
            "type": "string"
          }
        },
        "required": ["pointer", "detail"],
        "title": "ProblemError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Minimal versioned HTTP adapter over composition. Unknown paths return RFC 9457 Problem Details with status 404 (app-level; not declared per operation).",
    "title": "Kernector API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/capabilities": {
      "get": {
        "description": "Expose buildable providers and tool-pack enablement via composition.",
        "operationId": "capabilities_api_v1_capabilities_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilitiesResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "405": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Method not allowed"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Server error"
          }
        },
        "summary": "Capabilities",
        "tags": ["capabilities"]
      }
    },
    "/health": {
      "get": {
        "description": "Return process readiness without touching composition or infrastructure.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "405": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Method not allowed"
          }
        },
        "summary": "Health",
        "tags": ["ops"]
      }
    }
  }
}
