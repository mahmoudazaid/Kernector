{
  "components": {
    "schemas": {
      "CapabilitiesResponse": {
        "description": "Minimal read-only prove-out for the composition boundary.",
        "properties": {
          "default_provider": {
            "title": "Default Provider",
            "type": "string"
          },
          "providers": {
            "items": {
              "type": "string"
            },
            "title": "Providers",
            "type": "array"
          },
          "software_delivery_tools_enabled": {
            "title": "Software Delivery Tools Enabled",
            "type": "boolean"
          }
        },
        "required": [
          "providers",
          "default_provider",
          "software_delivery_tools_enabled"
        ],
        "title": "CapabilitiesResponse",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Operational readiness payload for unversioned ``GET /health``.",
        "properties": {
          "status": {
            "examples": ["ok"],
            "title": "Status",
            "type": "string"
          }
        },
        "required": ["status"],
        "title": "HealthResponse",
        "type": "object"
      },
      "ModelSettingDefResponse": {
        "description": "One generation setting for Settings UI controls.",
        "properties": {
          "default": {
            "title": "Default",
            "type": "number"
          },
          "help": {
            "title": "Help",
            "type": "string"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "max_value": {
            "title": "Max Value",
            "type": "number"
          },
          "min_value": {
            "title": "Min Value",
            "type": "number"
          },
          "providers": {
            "items": {
              "type": "string"
            },
            "title": "Providers",
            "type": "array"
          },
          "step": {
            "title": "Step",
            "type": "number"
          },
          "widget": {
            "title": "Widget",
            "type": "string"
          }
        },
        "required": [
          "key",
          "label",
          "widget",
          "default",
          "min_value",
          "max_value",
          "step",
          "help",
          "providers"
        ],
        "title": "ModelSettingDefResponse",
        "type": "object"
      },
      "OllamaSettingsResponse": {
        "description": "Ollama defaults from runtime config (live models come from probe).",
        "properties": {
          "default_base_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Default Base Url"
          },
          "default_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Default Model"
          }
        },
        "title": "OllamaSettingsResponse",
        "type": "object"
      },
      "OllamaStatusResponse": {
        "description": "Ollama reachability and installed models for a base URL.",
        "properties": {
          "models": {
            "items": {
              "type": "string"
            },
            "title": "Models",
            "type": "array"
          },
          "reachable": {
            "title": "Reachable",
            "type": "boolean"
          }
        },
        "required": ["reachable", "models"],
        "title": "OllamaStatusResponse",
        "type": "object"
      },
      "OpenRouterSettingsResponse": {
        "description": "OpenRouter models and default from runtime config.",
        "properties": {
          "default_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Default Model"
          },
          "models": {
            "items": {
              "type": "string"
            },
            "title": "Models",
            "type": "array"
          }
        },
        "required": ["models"],
        "title": "OpenRouterSettingsResponse",
        "type": "object"
      },
      "Problem": {
        "description": "RFC 9457 Problem Details plus Kernector extensions.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ProblemError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Errors"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Instance"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Request Id"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": ["type", "title", "status", "detail", "code"],
        "title": "Problem",
        "type": "object"
      },
      "ProblemError": {
        "description": "Field-level Problem Details extension entry.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "pointer": {
            "title": "Pointer",
            "type": "string"
          }
        },
        "required": ["pointer", "detail"],
        "title": "ProblemError",
        "type": "object"
      },
      "RuntimeSettingsResponse": {
        "description": "Catalog for provider/model/settings controls (Streamlit sidebar parity).",
        "properties": {
          "default_provider": {
            "title": "Default Provider",
            "type": "string"
          },
          "model_settings": {
            "items": {
              "$ref": "#/components/schemas/ModelSettingDefResponse"
            },
            "title": "Model Settings",
            "type": "array"
          },
          "ollama": {
            "$ref": "#/components/schemas/OllamaSettingsResponse"
          },
          "openrouter": {
            "$ref": "#/components/schemas/OpenRouterSettingsResponse"
          },
          "providers": {
            "items": {
              "type": "string"
            },
            "title": "Providers",
            "type": "array"
          }
        },
        "required": [
          "providers",
          "default_provider",
          "openrouter",
          "ollama",
          "model_settings"
        ],
        "title": "RuntimeSettingsResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Minimal versioned HTTP adapter over composition. Unknown paths return RFC 9457 Problem Details with status 404 (app-level; not declared per operation).",
    "title": "Kernector API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/capabilities": {
      "get": {
        "description": "Expose buildable providers and tool-pack enablement via composition.",
        "operationId": "capabilities_api_v1_capabilities_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilitiesResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "405": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Method not allowed"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Server error"
          }
        },
        "summary": "Capabilities",
        "tags": ["capabilities"]
      }
    },
    "/api/v1/ollama/status": {
      "get": {
        "description": "Probe Ollama reachability and list installed models for ``base_url``.",
        "operationId": "ollama_status_api_v1_ollama_status_get",
        "parameters": [
          {
            "description": "Ollama server base URL",
            "in": "query",
            "name": "base_url",
            "required": true,
            "schema": {
              "description": "Ollama server base URL",
              "minLength": 1,
              "title": "Base Url",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OllamaStatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "405": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Method not allowed"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Validation error"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Server error"
          }
        },
        "summary": "Ollama Status",
        "tags": ["settings"]
      }
    },
    "/api/v1/settings": {
      "get": {
        "description": "Expose providers, env defaults, and model-settings catalog for Settings UI.",
        "operationId": "runtime_settings_api_v1_settings_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeSettingsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "405": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Method not allowed"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Server error"
          }
        },
        "summary": "Runtime Settings",
        "tags": ["settings"]
      }
    },
    "/health": {
      "get": {
        "description": "Return process readiness without touching composition or infrastructure.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "405": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Method not allowed"
          }
        },
        "summary": "Health",
        "tags": ["ops"]
      }
    }
  }
}
