# Public environment variables for the Kernector Next.js shell.
# Never put secrets here — only NEXT_PUBLIC_* values that are safe to expose
# to the browser.

NEXT_PUBLIC_APP_NAME=Kernector

# Browser-visible API origin (no trailing slash). Defaults to local FastAPI.
#
# NEXT_PUBLIC_* values are inlined at BUILD time, not read at runtime. A
# production build that leaves this unset ships the localhost default to every
# browser and the header health chip reads "Unavailable" for all users. Set it
# in the build environment before `npm run build` when deploying.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
