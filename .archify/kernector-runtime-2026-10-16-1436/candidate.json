  "cards": [
    {
      "dot": "cyan",
      "title": "Test Design path",
      "items": [
        "QA sends a GitHub Issue URL or a Jira key",
        "Kernector reads the issue live, then the engineer confirms coverage",
        "Generate writes manual or Cucumber cases for the kept candidates",
        "A changed issue fingerprint stops the write",
        "Cases can be exported or created as Xray tests"
      ]
    },
    {
      "dot": "emerald",
      "title": "Inward dependencies",
      "items": [
        "Application speaks to the outside only through domain ports",
        "Composition is the only layer that activates a pack",
        "The software-delivery pack is on only when DOMAIN_TOOL_PACKS allows it",
        "Chroma stores embeddings; BM25 is added when hybrid search is on"
      ]
    },
    {
      "dot": "rose",
      "title": "Credentials",
      "items": [
        "MCP requires a bearer token; /healthz stays public",
        "Jira Data Center PAT stays in settings and is not returned",
        "Next.js talks to FastAPI over HTTP and does not hold tracker tokens"
      ]
    }
  ]
